{
  "name": "mobile-pos",
  "productName": "Mobile Shop Manager",
  "version": "1.0.0",
  "description": "Offline inventory, sales and customer management for a mobile phone shop",
  "main": "electron/main.js",
  "scripts": {
    "build:client": "cd client && npm install --legacy-peer-deps && npm run build && cd ..",
    "dev": "npm run build:client && electron .",
    "start": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3,bcrypt",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.mobileshop.manager",
    "productName": "Mobile Shop Manager",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "index.js",
      "config/**/*",
      "controllers/**/*",
      "routes/**/*",
      "middlewares/**/*",
      "db/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
